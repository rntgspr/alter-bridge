#!/usr/bin/env bash
# Agent bridge: filesystem-based async messaging between agents of different
# providers (Claude Code, Codex). One file per message, atomic mv on delivery
# and on archival.
#
# Agents are addressed as provider:slug — e.g. claude:pikachu, codex:bridge.
# A leading # is accepted but needs shell quoting, so the bare form is preferred.
set -euo pipefail

ROOT="${AGENT_BRIDGE_ROOT:-$HOME/.agent-bridge}"

# UTC timestamp, lexicographically sortable. Milliseconds included so two
# messages sent in the same second still read back in the order they were sent.
now_ts() {
  perl -MPOSIX -MTime::HiRes=gettimeofday -e \
    'my ($s, $us) = gettimeofday; print strftime("%Y%m%dT%H%M%S", gmtime($s)), sprintf(".%03dZ", $us / 1000)'
}

# 8 random hex chars, enough to break same-millisecond collisions. Reads a fixed
# 4 bytes so no stage of the pipe ever gets SIGPIPE under pipefail.
rand_id() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }

# Splits "#provider:slug" (# optional) into "provider slug". Runs inside a
# command substitution, so it never exits on its own — check_addr does that.
parse_addr() {
  local addr="${1#\#}"
  printf '%s %s' "${addr%%:*}" "${addr#*:}"
}

# Aborts unless the address looks like #provider:slug. Called from the caller's
# own shell, where an exit actually stops the script.
check_addr() {
  case "${1#\#}" in
    ?*:?*) return 0 ;;
    *) printf 'agent-bridge: address must be provider:slug (got "%s")\n' "$1" >&2; exit 2 ;;
  esac
}

# Makes a session name safe as a directory name. Names are free text — one of
# Renato's sessions is called "workspace/fe" — and a slash would silently nest
# the mailbox one level down.
slugify() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9._-' '-' \
    | sed 's/-\{2,\}/-/g; s/^-//; s/-$//'
}

# The name Claude Code shows for a session id — the same name the human sees in
# the session list and types when addressing it.
claude_session_name() {
  local sid="${1:-}"
  [ -n "$sid" ] || return 0
  command -v claude >/dev/null 2>&1 || return 0
  claude agents --json 2>/dev/null \
    | jq -r --arg s "$sid" '.[] | select(.sessionId == $s) | .name // empty' 2>/dev/null \
    | head -1
}

# Same, for Codex: the thread name lives in its state database, with an
# append-only index as fallback when the database is busy or absent.
codex_session_name() {
  local sid="${1:-}" name=""
  [ -n "$sid" ] || return 0

  if [ -r "$HOME/.codex/state_5.sqlite" ] && command -v sqlite3 >/dev/null 2>&1; then
    name="$(sqlite3 "file:$HOME/.codex/state_5.sqlite?mode=ro" \
      "select coalesce(nullif(name,''), '') from threads where id='$sid' limit 1;" 2>/dev/null || true)"
  fi

  if [ -z "$name" ] && [ -r "$HOME/.codex/session_index.jsonl" ]; then
    name="$(jq -r --arg s "$sid" 'select(.id == $s) | .thread_name // empty' \
      "$HOME/.codex/session_index.jsonl" 2>/dev/null | tail -1)"
  fi

  printf '%s' "$name"
}

# This session's own address. The session name is the identity, because two
# sessions can share a working directory and only the name tells them apart.
# AGENT_SLUG still overrides it; the directory is the last resort, for calls
# made outside a hook where no session id is at hand.
self_addr() {
  local sid="${1:-}" slug="${AGENT_SLUG:-}" provider="claude"

  # Which CLI is running this decides the provider half of the address.
  if [ -n "${CODEX_THREAD_ID:-}${CODEX_SESSION_ID:-}" ]; then provider="codex"; fi

  # Outside a hook there is no payload, but both CLIs export the session id to
  # the commands they run, so a hand-run `send` signs with the same address the
  # hook listens on.
  if [ -z "$sid" ]; then
    case "$provider" in
      codex)  sid="${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}" ;;
      claude) sid="${CLAUDE_CODE_SESSION_ID:-}" ;;
    esac
  fi

  if [ -z "$slug" ] && [ -n "$sid" ]; then
    case "$provider" in
      codex)  slug="$(codex_session_name "$sid")" ;;
      claude) slug="$(claude_session_name "$sid")" ;;
    esac
  fi

  if [ -z "$slug" ]; then
    local rest="${PWD#"$HOME"/agentic-workspace/}"
    if [ "$rest" != "$PWD" ] && [ -n "$rest" ]; then slug="${rest%%/*}"; else slug="default"; fi
  fi

  printf '%s:%s' "$provider" "$(slugify "$slug")"
}

# The Codex thread id whose (slugified) name matches an address. Derived live
# from Codex's own state, so nothing has to be kept in sync on our side.
codex_thread_for_slug() {
  local slug="$1" line id name
  [ -r "$HOME/.codex/state_5.sqlite" ] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0
  sqlite3 "file:$HOME/.codex/state_5.sqlite?mode=ro" \
    "select id || '|' || coalesce(name,'') from threads order by updated_at desc limit 200;" 2>/dev/null \
  | while IFS='|' read -r id name; do
      [ -n "$name" ] || continue
      if [ "$(slugify "$name")" = "$slug" ]; then printf '%s\n' "$id"; break; fi
    done | head -1
}

usage() {
  cat >&2 <<'USAGE'
usage:
  agent-bridge send provider:slug [options] [body_file]
      options: --from provider:slug      who is sending (default: this session)
               --type message|question|result|ack
               --thread ID  --in-reply-to MSGID
      body_file omitted or "-" reads the body from stdin.
  agent-bridge inbox [provider:slug]      # prints pending, archives them
  agent-bridge peek  [provider:slug]      # prints pending, keeps them
  agent-bridge hook  [provider:slug]      # UserPromptSubmit entry point:
                                             # registers this session, drains
  agent-bridge archive [provider:slug]    # archive pending without reading
                                             # (no address = every mailbox)
  agent-bridge purge                      # delete the archived trail
  agent-bridge who                        # addresses that announced themselves
  agent-bridge watchpaths [provider:slug] # SessionStart: register the mailbox
                                             # with the FileChanged watcher
  agent-bridge relay                      # FileChanged: wake this session up

A leading # is accepted ('#codex:bridge'), but must be quoted — bash reads a
bare leading # as the start of a comment.
USAGE
  exit 2
}

# Writes a message file into the recipient's mailbox and echoes its path.
# Absolute path to the Claude CLI. Callers reach this script from other agents'
# shells — Codex among them — where ~/.local/bin is not always on PATH, so a
# bare `claude` would silently resolve to nothing and the nudge would vanish.
claude_bin() {
  command -v claude 2>/dev/null || printf '%s' "$HOME/.local/bin/claude"
}

send() {
  local to="${1:-}"; shift || usage
  [ -n "$to" ] || usage

  local from thread="" reply="" type="message" body=""
  from="$(self_addr)"

  while [ $# -gt 0 ]; do
    case "$1" in
      --from)        from="$2"; shift 2 ;;
      --type)        type="$2"; shift 2 ;;
      --thread)      thread="$2"; shift 2 ;;
      --in-reply-to) reply="$2"; shift 2 ;;
      -h|--help)     usage ;;
      *)             body="$1"; shift ;;
    esac
  done

  check_addr "$to"; check_addr "$from"

  local rp rs sp ss
  read -r rp rs <<<"$(parse_addr "$to")"
  read -r sp ss <<<"$(parse_addr "$from")"

  local dir="$ROOT/$rp/$rs" tmpdir="$ROOT/.tmp"
  mkdir -p "$dir" "$tmpdir"

  local ts msgid dest
  ts="$(now_ts)"
  # Regenerate on the (improbable) chance the target name already exists.
  while :; do
    msgid="$(rand_id)"
    dest="$dir/${ts}__from_${sp}_${ss}__${msgid}.md"
    [ -e "$dest" ] || break
  done

  local tmp
  tmp="$(mktemp "$tmpdir/msg.XXXXXXXX")"
  {
    printf -- '---\n'
    printf 'from: %s:%s\n' "$sp" "$ss"
    printf 'to: %s:%s\n' "$rp" "$rs"
    printf 'ts: %s\n' "$ts"
    printf 'msgid: %s\n' "$msgid"
    if [ -n "$thread" ]; then printf 'thread: %s\n' "$thread"; fi
    if [ -n "$reply" ]; then printf 'in_reply_to: %s\n' "$reply"; fi
    printf 'type: %s\n' "$type"
    printf -- '---\n\n'
    if [ -z "$body" ] || [ "$body" = "-" ]; then cat; else cat "$body"; fi
  } >"$tmp"

  mv "$tmp" "$dest"

  # Nudge a live session so it reads the mailbox now instead of waiting for its
  # next prompt. No-op when that session is not running; the file is already
  # delivered either way.
  if [ "$rp" = "codex" ] && command -v codex >/dev/null 2>&1; then
    local thread; thread="$(codex_thread_for_slug "$rs")"
    [ -n "$thread" ] || thread="$rs"   # --thread also accepts the session name
    codex queue --thread "$thread" \
      --message "agent-bridge: new message from ${sp}:${ss} (msgid ${msgid}). Run: ~/.agents/skills/agent-bridge/scripts/agent-bridge inbox ${rp}:${rs}" \
      >/dev/null 2>&1 || true
  fi

  printf '%s\n' "$dest"
}

# Prints every pending message, oldest first. Archives each one before printing
# it so a failed turn never reprocesses the same message.
drain() {
  local do_archive="$1" addr="${2:-}" quiet="${3:-}"
  [ -n "$addr" ] || addr="$(self_addr)"

  check_addr "$addr"

  local sp ss
  read -r sp ss <<<"$(parse_addr "$addr")"

  local dir="$ROOT/$sp/$ss" arch="$ROOT/.archive"
  [ -d "$dir" ] || return 0

  local f base prefix id dest count=0
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"

    if [ "$do_archive" = "yes" ]; then
      mkdir -p "$arch"
      # <ts>__from_<sender>__<msgid>.md -> <ts>__from_<sender>__to_<self>__<msgid>.md
      prefix="${base%__*}"; id="${base##*__}"
      dest="$arch/${prefix}__to_${sp}_${ss}__${id}"
      # Two files can reduce to the same archived name — hand-dropped ones above
      # all, since their names carry neither timestamp nor msgid to tell them
      # apart. Archiving must never be what loses a message.
      while [ -e "$dest" ]; do dest="${dest%.md}.$(rand_id).md"; done
      mv "$f" "$dest"
      f="$dest"
    fi

    if [ "$quiet" = "quiet" ]; then
      count=$((count + 1))
      continue
    fi

    printf '===== AGENT-BRIDGE MESSAGE: %s =====\n' "$base"
    cat "$f"
    printf '\n'
  done

  if [ "$quiet" = "quiet" ]; then printf '%s\n' "$count"; fi
}

inbox() { drain yes "$@"; }
peek()  { drain no  "$@"; }

# Entry point for the UserPromptSubmit hook of either CLI. Reads the harness
# payload on stdin (session_id, cwd), records this session's identity so others
# can reach it by id, then drains its mailbox.
hook() {
  local payload sid cwd addr="${1:-}"
  payload="$(cat)"
  sid="$(printf '%s' "$payload" | jq -r '.session_id // .thread_id // .threadId // empty' 2>/dev/null || true)"
  cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"

  if [ -n "$cwd" ]; then cd "$cwd" 2>/dev/null || true; fi

  case "$PWD" in
    "$HOME"/agentic-workspace|"$HOME"/agentic-workspace/*) ;;
    *) return 0 ;;
  esac

  [ -n "$addr" ] || addr="$(self_addr "$sid")"
  check_addr "$addr"

  drain yes "$addr"
}

# SessionStart entry point: registers this agent's mailbox with the FileChanged
# watcher so a message landing there rings immediately, even while the session
# sits idle. The directory has to exist at registration time, hence the mkdir.
watchpaths() {
  local payload cwd sid addr provider slug dir
  payload="$(cat)"
  cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"
  sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"

  if [ -n "$cwd" ]; then cd "$cwd" 2>/dev/null || true; fi
  case "$PWD" in
    "$HOME"/agentic-workspace|"$HOME"/agentic-workspace/*) ;;
    *) return 0 ;;
  esac

  addr="${1:-}"
  [ -n "$addr" ] || addr="$(self_addr "$sid")"
  check_addr "$addr"
  read -r provider slug <<<"$(parse_addr "$addr")"

  # Register both the provider directory and this agent's own mailbox. The
  # parent keeps ringing after a `/rename` moves the mailbox and covers
  # mailboxes that do not exist yet; the leaf covers the case where the watcher
  # does not descend into subdirectories, which the harness does not document.
  # `relay` decides whether an arrival is ours.
  dir="$ROOT/$provider"
  mkdir -p "$dir/$slug" "$ROOT/.tmp"

  jq -nc --arg p "$dir" --arg m "$dir/$slug" \
    '{hookSpecificOutput:{hookEventName:"SessionStart",watchPaths:[$p,$m]}}'
}

# FileChanged entry point: turns a new mailbox file into a one-line notice for
# the human. Only `add` counts — a new file is a new message. Nothing is read or
# archived here; the model still receives the message on the next turn, through
# the UserPromptSubmit hook. This event carries no context channel.
relay() {
  local payload path event sid base sender msgid mine provider slug note
  payload="$(cat)"
  # Records every harness invocation. The FileChanged watcher has been seen dying
  # silently after a couple of hours — no error, no log, the session simply goes
  # deaf — and this line is the only way to tell "the hook never fired" apart
  # from "the hook fired and the relay failed". Restarting the session is the
  # only known recovery, since watchPaths is registered at SessionStart alone.
  printf '%s %s\n' "$(date -u +%H:%M:%S)" "$payload" >>"$ROOT/.tmp/relay.log" 2>/dev/null || true
  path="$(printf '%s' "$payload" | jq -r '.file_path // empty' 2>/dev/null || true)"
  event="$(printf '%s' "$payload" | jq -r '.event // empty' 2>/dev/null || true)"
  sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"

  [ "$event" = "add" ] || return 0
  case "$path" in "$ROOT"/*) ;; *) return 0 ;; esac

  # The watch covers every mailbox of this provider, so ring only for our own.
  mine="$(self_addr "$sid")"
  read -r provider slug <<<"$(parse_addr "$mine")"
  [ "$(dirname "$path")" = "$ROOT/$provider/$slug" ] || return 0

  base="$(basename "$path")"
  case "$base" in *__from_*__*.md) ;; *) return 0 ;; esac

  sender="${base#*__from_}"; sender="${sender%%__*}"
  msgid="${base##*__}"; msgid="${msgid%.md}"

  note="agent-bridge: new message from ${sender/_/:} (msgid ${msgid})"

  # Claude has no `codex queue`: the only way into a live session's queue is the
  # SendMessage tool, and only a Claude can call it. So a throwaway headless
  # session is spawned purely to relay the ring — Haiku at low effort, since the
  # whole job is a single tool call. Detached, because it costs an API round trip
  # and the hook has a 10s budget.
  #
  # This runs on the recipient's side, under its own harness, so it inherits a
  # working PATH and login no matter which agent sent the message — and a message
  # dropped in by hand rings just the same.
  #
  # The prompt goes in through stdin: --allowedTools is variadic and would
  # swallow a positional prompt as a second tool name. The cwd is ~/.claude:
  # outside the workspace, so this script's own hooks stay dormant and the relay
  # leaves no orphan mailbox, and in no project, so the throwaway session never
  # shows up attached to work it has nothing to do with. It is named after the
  # sender it rings for, so a stray relay in `claude agents` says whose message
  # it was carrying.
  # The relay's session id is chosen here rather than read back afterwards, so
  # its transcript can be deleted by exact path once it exits. Guessing which
  # transcript belonged to which relay would be a race; this is not.
  local rid proj
  rid="$(uuidgen)"
  proj="$(printf '%s' "$HOME/.claude" | tr '/.' '--')"

  if [ -x "$(claude_bin)" ]; then
    ( cd "$HOME/.claude" \
        && printf '%s\n' "Use the SendMessage tool to send the session named \"${slug}\" exactly this message: \"${note}\". Do nothing else." \
        | "$(claude_bin)" -p --session-id "$rid" \
            --name "relay-$(slugify "${sender/_/:}")" \
            --model claude-haiku-4-5-20251001 --effort low \
            --allowedTools=SendMessage >/dev/null 2>&1
      rm -f "$HOME/.claude/projects/$proj/$rid.jsonl" ) >/dev/null 2>&1 &
  fi

  jq -nc --arg m "$note" '{systemMessage: $m}'
}

# Archives every pending message without printing it — for dropping a backlog
# you have decided not to act on. Without an address it sweeps every mailbox.
archive() {
  local addr="${1:-}" total=0 n provider slug d

  if [ -n "$addr" ]; then
    check_addr "$addr"
    n="$(drain yes "$addr" quiet)"
    printf 'archived %s from %s\n' "$n" "$addr"
    return 0
  fi

  for d in "$ROOT"/*/*; do
    [ -d "$d" ] || continue
    slug="$(basename "$d")"; provider="$(basename "$(dirname "$d")")"
    case "$provider" in .*) continue ;; esac
    n="$(drain yes "$provider:$slug" quiet)"
    [ "$n" -gt 0 ] || continue
    printf 'archived %s from %s:%s\n' "$n" "$provider" "$slug"
    total=$((total + n))
  done
  printf 'total: %s\n' "$total"
}

# Deletes the archived trail. Only *.md directly under .archive is touched, so a
# mistyped ROOT cannot take anything else with it. This is not reversible.
purge() {
  local arch="$ROOT/.archive" n=0 f
  [ -d "$arch" ] || { printf 'nothing to purge\n'; return 0; }
  for f in "$arch"/*.md; do
    [ -e "$f" ] || continue
    rm -f "$f"
    n=$((n + 1))
  done
  printf 'purged %s archived message(s) from %s\n' "$n" "$arch"
}

# Lists addressable agents, read live from each CLI's own session state. No
# registry is kept here: the CLIs already know who exists, and a second copy
# would only drift.
who() {
  local id name slug

  if command -v claude >/dev/null 2>&1; then
    claude agents --json 2>/dev/null \
      | jq -r '.[] | select(.kind == "interactive") | "\(.sessionId)|\(.name // "")|\(.cwd // "")"' 2>/dev/null \
      | while IFS='|' read -r id name cwd; do
          [ -n "$name" ] || continue
          printf '%-26s %s  %s\n' "claude:$(slugify "$name")" "$id" "$cwd"
        done
  fi

  if [ -r "$HOME/.codex/state_5.sqlite" ] && command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "file:$HOME/.codex/state_5.sqlite?mode=ro" \
      "select id || '|' || coalesce(name,'') from threads order by updated_at desc limit 10;" 2>/dev/null \
      | while IFS='|' read -r id name; do
          [ -n "$name" ] || continue
          printf '%-26s %s\n' "codex:$(slugify "$name")" "$id"
        done
  fi
}

[ $# -gt 0 ] || usage
cmd="$1"; shift
case "$cmd" in
  send|inbox|peek|hook|who|watchpaths|relay|archive|purge) "$cmd" "$@" ;;
  *) usage ;;
esac
